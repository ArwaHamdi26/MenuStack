{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compile C++",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/src/*.cpp",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compiles the C++ source files."
        },
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "gnome-terminal",
            "args": [
                "--",
                "bash",
                "-c",
                "${workspaceFolder}/main; echo ''; read -p 'Press Enter to close...'"
            ],
            "dependsOn": "Compile C++",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}